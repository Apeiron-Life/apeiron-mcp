# Copy to `.env` and fill in real values: `cp .env.example .env`
# `.env` is git-ignored and must never be committed.

# --------------------------------------------------------------------------- #
# Apeiron backend (used by src/apeiron_mcp/apeiron_client.py).
# Without APEIRON_ACCESS_TOKEN the tools return stub data.
# --------------------------------------------------------------------------- #
APEIRON_BASE_URL=https://api.apeiron.life
APEIRON_ACCESS_TOKEN=
APEIRON_TIMEOUT=30

# --------------------------------------------------------------------------- #
# MCP server / container
# --------------------------------------------------------------------------- #
# stdio | streamable-http | sse
MCP_TRANSPORT=streamable-http

# Bind address inside the container. Keep 0.0.0.0 so the port is reachable.
MCP_HOST=0.0.0.0

# Port inside the container (must match the container side of the mapping).
MCP_PORT=8000

# Port published on the host by docker compose.
MCP_HOST_PORT=8000

# Set to true when behind a load balancer that cannot keep session affinity.
MCP_STATELESS_HTTP=false

# Set to true to answer with plain JSON instead of SSE streams (simpler to
# probe with curl, but not all clients support it).
MCP_JSON_RESPONSE=false

# Optional Host / Origin allowlists. Setting MCP_ALLOWED_HOSTS turns
# DNS-rebinding protection ON; requests with any other Host header get a 421.
# Entries are matched against the Host header INCLUDING the port, so list both
# forms when unsure (a trailing ":*" allows any port):
#   MCP_ALLOWED_HOSTS=apeiron.example.com,apeiron.example.com:*
# Leave unset for container-local use, set it when exposing the service.
# MCP_ALLOWED_HOSTS=apeiron.example.com,apeiron.example.com:*
# MCP_ALLOWED_ORIGINS=https://apeiron.example.com
